{
  "name": "vortex-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run build:renderer && npm run build:electron && electron-builder",
    "electron:dev": "npm run build:electron && concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"electron .\""
  },
  "dependencies": {
    "axios": "1.11.0",
    "clsx": "2.1.1",
    "lucide-react": "0.344.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.0.0",
    "@types/node": "22.15.3",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.2.1",
    "concurrently": "8.2.2",
    "electron": "29.1.0",
    "electron-builder": "24.13.0",
    "tailwindcss": "4.0.0",
    "typescript": "5.3.3",
    "vite": "5.1.4"
  }
}
