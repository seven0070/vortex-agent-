#!/usr/bin/env bash
# Vortex Agent launcher (Hermes-style ./hermes binary)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
if [[ -x "${ROOT}/.venv/bin/python" ]]; then
  exec "${ROOT}/.venv/bin/python" -m vortex "$@"
fi
if [[ -x /tmp/vortex-venv/bin/python ]]; then
  exec /tmp/vortex-venv/bin/python -m vortex "$@"
fi
exec python3 -m vortex "$@"
